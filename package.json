{
  "name": "pistonrh",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/piston-rh run dev",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed:admin": "pnpm --filter @workspace/api-server run seed:admin",
    "typecheck:libs": "pnpm --filter @workspace/db --filter @workspace/api-zod --filter @workspace/api-client-react run typecheck",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/api-server --filter @workspace/piston-rh run typecheck",
    "build": "pnpm run typecheck && pnpm --filter @workspace/piston-rh run build && pnpm --filter @workspace/api-server run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "orval": "^7.5.0"
  }
}
